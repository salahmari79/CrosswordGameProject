<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الكلمات المتقاطعة"
            android:textColor="#FFD700"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Learn English with Fun!"
            android:textColor="#80FFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp" />

        <!-- Social Buttons -->
        <Button
            android:id="@+id/btnGoogleSignIn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Continue with Google"
            android:textColor="#000000"
            android:backgroundTint="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnFacebookSignIn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Continue with Facebook"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1877F2"
            android:layout_marginBottom="20dp" />

        <!-- Separator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#404040" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OR" android:textColor="#80FFFFFF" android:paddingHorizontal="16dp" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#404040" />
        </LinearLayout>

        <!-- Email Form -->
        <LinearLayout
            android:id="@+id/layoutRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Username"
                android:textColorHint="#80FFFFFF"
                android:textColor="#FFFFFF"
                android:background="@drawable/edit_text_bg"
                android:padding="16dp"
                android:layout_marginBottom="12dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Email"
            android:textColorHint="#80FFFFFF"
            android:textColor="#FFFFFF"
            android:inputType="textEmailAddress"
            android:background="@drawable/edit_text_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Password"
            android:textColorHint="#80FFFFFF"
            android:textColor="#FFFFFF"
            android:inputType="textPassword"
            android:background="@drawable/edit_text_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Confirm Password"
            android:textColorHint="#80FFFFFF"
            android:textColor="#FFFFFF"
            android:inputType="textPassword"
            android:background="@drawable/edit_text_bg"
            android:padding="16dp"
            android:layout_marginBottom="24dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnEmailAuth"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Log In"
            android:textColor="#1A1A2E"
            android:backgroundTint="#FFD700"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvToggleMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Need an account? Sign up"
            android:textColor="#FFD700"
            android:padding="12dp"
            android:layout_marginTop="8dp" />

        <!-- Guest Mode Button -->
        <TextView
            android:id="@+id/tvSkipLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Continue as Guest"
            android:textColor="#80FFFFFF"
            android:padding="12dp"
            android:textStyle="italic" />

    </LinearLayout>
</ScrollView>
